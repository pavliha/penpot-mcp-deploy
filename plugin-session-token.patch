+const sessionTokenInput = document.getElementById("session-token") as HTMLInputElement;
+const SESSION_TOKEN_KEY = "penpot-mcp-session-token";
+
+const readStoredToken = (): string => {
+    try {
+        return sessionStorage.getItem(SESSION_TOKEN_KEY) ?? "";
+    } catch {
+        return "";
+    }
+};
+
+const storeToken = (token: string): void => {
+    try {
+        sessionStorage.setItem(SESSION_TOKEN_KEY, token);
+    } catch {
+        return;
+    }
+};
+
+sessionTokenInput.value = PENPOT_MCP_BAKED_TOKEN || readStoredToken();
+const tokenField = sessionTokenInput.closest(".session-token-field") as HTMLElement | null;
+if (PENPOT_MCP_BAKED_TOKEN && tokenField) tokenField.hidden = true;
